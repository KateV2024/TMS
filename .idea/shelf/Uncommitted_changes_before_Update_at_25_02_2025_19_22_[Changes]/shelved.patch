-    daisy = Daisy(name="Daisy", cost=2.5, lifespan=36)
-
-    # Создание аксессуаров
-    ribbon = Accessory(name="Ribbon", cost=1.0)
-    paper = Accessory(name="Wrapping Paper", cost=2.0)
-
-    # Создание букета
